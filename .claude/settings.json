{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "args": [
              "attention-hook",
              "end"
            ],
            "command": "kata",
            "type": "command"
          }
        ],
        "matcher": "logout|prompt_input_exit|bypass_permissions_disabled|other"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "attention-hook",
              "start"
            ],
            "command": "kata",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  }
}
